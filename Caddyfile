rsgo.io, www.rsgo.io {
	# Secure WebSocket: terminate TLS here, forward as plain ws to the backend.
	# Frontend connects to wss://rsgo.io/ws on https pages.
	@ws path /ws /ws/*
	reverse_proxy @ws rsgo-backend:6969

	# Everything else -> the static frontend.
	reverse_proxy rsgo-frontend:80

	encode gzip
}

analytics.rsgo.io {
	reverse_proxy rsgo-umami:3000
	encode gzip
}
